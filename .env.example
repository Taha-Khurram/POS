# Copy to .env.local and fill from Supabase → Project Settings → API keys.

# Browser-safe. The publishable key, not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. This key bypasses RLS: it can create a tenant, mint an invite,
# and create an auth user. It must never be prefixed NEXT_PUBLIC_, never be
# imported outside `utils/supabase/admin.ts`, and only ever live in .env.local
# and the host's environment settings.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional. Where the sign-up links the platform console mints point. Left
# unset, the origin is read off the request, which is right on localhost and on
# a normal deployment — set it only behind a proxy that rewrites the host, since
# an invite link that is nearly right is one nobody notices until the shop rings
# up to say it is broken.
NEXT_PUBLIC_SITE_URL=https://flopos.pk
